# Database profiles: enable exactly ONE profile. Defaults are ready; normally
# only DB_PASSWORD and DB_NAME need changing. Keep DATABASE_URL commented when
# using discrete fields. Do not commit this file with real passwords.

# [A] Supabase PostgreSQL transaction pooler (recommended; IPv4, port 6543)
# DB_DRIVER=supabase
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.xiqoppirsszygylfsona
# DB_PASSWORD=fill-your-supabase-password
# DB_SSL=true
# DB_SSL_VERIFY=false
# DATABASE_URL=postgresql://postgres.xiqoppirsszygylfsona:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# [B] Local PostgreSQL (Laragon or WSL)
# DB_DRIVER=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=nuxtblog
# DB_USER=postgres
# DB_PASSWORD=fill-your-postgres-password
# DB_SSL=false
# DB_SSL_VERIFY=true

# [C] Local MySQL (Laragon or WSL)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nuxtblog
# DB_USER=root
# DB_PASSWORD=fill-your-mysql-password
# DB_SSL=false
# DB_SSL_VERIFY=true

# [D] Test-only in-memory store
# DB_DRIVER=memory
# DB_NAME=nuxtblog
# DB_PASSWORD=

DB_SSL=true
DB_SSL_VERIFY=false
SEED_DEMO=false
# Only enable this when intentionally running without the configured database.
ALLOW_MEMORY_FALLBACK=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000

# Supabase Data API client (publishable key only; never put service_role here).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=sb_publishable_<publishable-key>

# Legacy BLOG_DB_* variables are intentionally disabled. The application must
# use DB_DRIVER/DB_* above; do not configure a second database here.
# BLOG_DB_DRIVER=mysql
# BLOG_DB_HOST=127.0.0.1
# BLOG_DB_PORT=3306
# BLOG_DB_NAME=nuxtblog
# BLOG_DB_USER=root
# BLOG_DB_PASSWORD=
# BLOG_DATABASE_URL=mysql://user:password@127.0.0.1:3306/nuxtblog

# Initial admin account (seeded once when the users table is empty)
BLOG_ADMIN_EMAIL=admin@example.com
BLOG_ADMIN_PASSWORD=change-me-please
BLOG_ADMIN_NAME=Administrator

# Sessions
SESSION_TTL_HOURS=8
# set true behind HTTPS
COOKIE_SECURE=false
